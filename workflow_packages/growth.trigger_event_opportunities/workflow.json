{
  "package_format": "tin-workflow-package-v1",
  "definition": {
    "key": "growth.trigger_event_opportunities",
    "title": "Prioritize Trigger-Event Growth Opportunities",
    "description": "Review a founder-supplied list of target companies and business signals, then identify which opportunities have the strongest timely reason for targeted outreach.",
    "version": "1.1.0",
    "executor": "workflow.code",
    "schedule_modes": ["on_demand"],
    "human_review": {
      "eligible": true,
      "summary": "Review the prioritized trigger-event opportunities before outreach"
    },
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "company_description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000,
          "title": "Product or company description"
        },
        "ideal_customer_profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000,
          "title": "Ideal customer profile"
        },
        "target_market": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "title": "Target market or geography"
        },
        "candidate_companies": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000,
          "title": "Candidate companies and recent signals"
        },
        "opportunity_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "title": "Number of opportunities"
        }
      },
      "required": [
        "project_id",
        "company_description",
        "ideal_customer_profile",
        "target_market",
        "candidate_companies",
        "opportunity_count"
      ]
    },
    "code": {
      "runtime": "python3.12.8-stdlib-v1",
      "entrypoint": "main.py",
      "files": ["main.py"],
      "timeout_seconds": 60,
      "model_routes": {
        "prioritize": {
          "provider": "openai",
          "model": "gpt-5.6-luna",
          "max_calls": 1,
          "max_input_bytes": 16000,
          "max_output_tokens": 2048
        }
      },
      "output": {
        "kind": "project.artifact",
        "path": "reports/TRIGGER_EVENT_OPPORTUNITIES.md",
        "media_type": "text/markdown",
        "max_bytes": 12000
      }
    }
  }
}
